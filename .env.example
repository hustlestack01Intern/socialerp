# SocialERP Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=socialerp
POSTGRES_PASSWORD=socialerp_dev_password
POSTGRES_DB=socialerp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://socialerp:socialerp_dev_password@localhost:5432/socialerp

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# META (WhatsApp + Instagram)
# =============================================================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
META_WEBHOOK_URL=https://your-domain.com/webhooks/meta
META_API_VERSION=v20.0
META_GRAPH_URL=https://graph.facebook.com

# WhatsApp specific
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Instagram specific
INSTAGRAM_PAGE_ID=your_page_id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# =============================================================================
# DARAJA (M-Pesa)
# =============================================================================
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_PASSKEY=your_daraja_passkey
DARAJA_SHORTCODE=174379
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CALLBACK_URL=https://your-domain.com/webhooks/daraja/callback
DARAJA_TIMEOUT_SECONDS=30

# =============================================================================
# PAYMENT AGGREGATORS (optional, for multi-merchant strategy)
# =============================================================================
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_URL=https://your-domain.com/webhooks/pesapal/ipn
PESAPAL_ENVIRONMENT=sandbox

INTASEND_PUBLIC_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_URL=https://your-domain.com/webhooks/intasend/callback
INTASEND_ENVIRONMENT=sandbox

# =============================================================================
# LLM GATEWAY
# =============================================================================
LLM_PROVIDER=local  # local, openai, anthropic, etc.
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_PER_TENANT_DAILY_CAP_USD=10.00

# =============================================================================
# OBSERVABILITY
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=socialerp
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORTER=prometheus
PROMETHEUS_PORT=9090

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_TIKTOK_ENABLED=false
FEATURE_INSTAGRAM_ENABLED=true
FEATURE_WHATSAPP_ENABLED=true
FEATURE_PAY_ON_DELIVERY_ENABLED=true
FEATURE_RIDER_TRACKING_ENABLED=false
FEATURE_AI_AGENT_L0=true
FEATURE_AI_AGENT_L1=false
FEATURE_AI_AGENT_L2=false
FEATURE_AI_AGENT_L3=false

# =============================================================================
# ONBOARDING
# =============================================================================
ONBOARDING_WIZARD_ENABLED=true
ONBOARDING_TARGET_MINUTES=30

# =============================================================================
# BILLING (SaaS)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PROFESSIONAL=
STRIPE_PRICE_ID_ENTERPRISE=

# =============================================================================
# EMAIL (for notifications, not customer-facing)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@socialerp.com

# =============================================================================
# KENYA DATA PROTECTION ACT
# =============================================================================
DPA_REGISTRATION_NUMBER=
DPA_DATA_CONTROLLER_NAME=
DPA_DATA_CONTROLLER_EMAIL=
DPA_RETENTION_DAYS=2555  # 7 years default

# =============================================================================
# DEVELOPMENT OVERRIDES (only used in development)
# =============================================================================
DEV_FAKE_META_URL=http://localhost:8080
DEV_FAKE_DARAJA_URL=http://localhost:8081
DEV_DISABLE_SIGNATURE_VERIFICATION=true
DEV_AUTO_CREATE_TENANT=true